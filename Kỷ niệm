<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kỷ Niệm 12A4 K60 - Cá Chép Hóa Rồng 2027</title>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root { --primary: #ff6b6b; --secondary: #4ecdc4; --accent: #ffe66d; --dark: #2f3542; }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Quicksand', sans-serif; }
        body { background-color: #f4f6f9; color: var(--dark); line-height: 1.6; }
        header { background: linear-gradient(135deg, #ff6b6b, #ff8e53); color: white; text-align: center; padding: 3rem 1rem; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        header h1 { font-family: 'Dancing Script', cursive; font-size: 3.5rem; margin-bottom: 0.5rem; }
        .countdown-container { background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(5px); border-radius: 15px; padding: 1.5rem; max-width: 600px; margin: 1.5rem auto 0; display: flex; justify-content: space-around; }
        .time-box span { display: block; font-size: 2rem; font-weight: 700; }
        .container { max-width: 1200px; margin: 2rem auto; padding: 0 1rem; }
        .section-title { text-align: center; font-size: 2rem; margin-bottom: 2rem; color: #333; }
        .section-title::after { content: ''; display: block; width: 60px; height: 4px; background: var(--primary); margin: 8px auto 0; }
        .grid-students { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem; }
        .student-card { background: white; border-radius: 12px; padding: 1.5rem; text-align: center; box-shadow: 0 4px 6px rgba(0,0,0,0.05); border-top: 5px solid var(--secondary); cursor: pointer; }
        .guestbook-form { background: white; padding: 1.5rem; border-radius: 10px; max-width: 600px; margin: 0 auto 2rem; }
        .guestbook-form input, .guestbook-form textarea, .guestbook-form button { width: 100%; margin-bottom: 1rem; padding: 0.8rem; border: 1px solid #ddd; border-radius: 8px; }
        .guestbook-form button { background: var(--primary); color: white; border: none; font-weight: bold; cursor: pointer; }
        .notes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.5rem; }
        .note-card { background: #fff9c4; padding: 1.2rem; border-radius: 5px; box-shadow: 3px 3px 10px rgba(0,0,0,0.1); transform: rotate(-1deg); display: flex; flex-direction: column; justify-content: space-between; }
        .note-card img { width: 100%; max-height: 180px; object-fit: cover; border-radius: 4px; margin: 0.5rem 0; }
        .note-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem; }
        .btn-edit { color: #0984e3; background: none; border: none; cursor: pointer; }
        .btn-delete { color: #d63031; background: none; border: none; cursor: pointer; }
        footer { text-align: center; padding: 2rem; background: var(--dark); color: white; margin-top: 4rem; }
    </style>
</head>
<body>
    <header>
        <h1>12A4 KHÓA 60</h1>
        <p>Hành Trình Rực Rỡ - Quyết Tâm Thi Tốt!</p>
        <div class="countdown-container">
            <div class="time-box"><span id="days">00</span><label>Ngày</label></div>
            <div class="time-box"><span id="hours">00</span><label>Giờ</label></div>
            <div class="time-box"><span id="minutes">00</span><label>Phút</label></div>
            <div class="time-box"><span id="seconds">00</span><label>Giây</label></div>
        </div>
    </header>
    <div class="container">
        <h2 class="section-title">Danh Sách 48 Sĩ Tử 12A4 K60</h2>
        <div class="grid-students" id="studentGrid"></div>
        <h2 class="section-title" style="margin-top: 4rem;">Tường Lưu Bút & Kỷ Niệm Hình Ảnh</h2>
        <div class="guestbook-form">
            <input type="hidden" id="editIndex" value="-1">
            <input type="text" id="senderName" placeholder="Tên của bạn..." required>
            <textarea id="noteContent" rows="3" placeholder="Gửi lời chúc thi tốt hoặc chia sẻ kỷ niệm..." required></textarea>
            <input type="file" id="imageInput" accept="image/*">
            <button id="submitBtn" onclick="saveNote()">Dán Lời Nhắn & Ảnh</button>
        </div>
        <div class="notes-grid" id="notesGrid"></div>
    </div>
    <footer><p>© 2027 Tập thể Lớp 12A4 Khóa 60</p></footer>
    <script>
        const students = ["Phạm Thúy An", "Phùng Hồng Ánh", "Nguyễn Mạnh Cường", "Cầm Thị Chi", "Nguyễn Khánh Chi", "Nguyễn Khánh Chi", "Vi Quốc Dũng", "Mùi Thị Duyên", "Phạm Thái Dương", "Nguyễn Duy Đạt", "Nguyễn Thành Đạt", "Đinh Thảo Hiền", "Nguyễn Phạm Gia Khánh", "Đinh Trọng Khôi", "Nguyễn Thị Phương Linh", "Triệu Thùy Linh", "Sa Đức Mạnh", "Ngô Vũ Tuấn Minh", "Mùi Thảo My", "Vì Trà My", "Đinh Thị An Na", "Hà Thị Kim Ngân", "Lò Thị Mai Ngọc", "Lường Thị Khánh Ngọc", "Hoàng Ngọc Nhi", "Nguyễn Linh Nhi", "Vì Quỳnh Như", "Đinh Nhân Nhượng", "Cẩm Hoàng Phát", "Đinh Gia Phong", "Hà Minh Phúc", "Nguyễn Hà Phương", "Đinh Thị Như Quỳnh", "Đinh Hùng Sơn", "Đinh Mạnh Tường", "Nguyễn Thị Mai Thủy", "Hà Thị Phương Thủy", "Đinh Thị Anh Thư", "Hà Anh Thư", "Nguyễn Thị Mai Thương", "Đặng Thùy Trang", "Phan Thu Trang", "Phùng Ngân Trang", "Đinh Quang Trung", "Phan Thị Ngọc Uyên", "Đinh Chí Vĩ", "Đinh Hà Vy", "Lò Thị Thanh Xuân"];
        const grid = document.getElementById('studentGrid');
        students.forEach((name, i) => {
            grid.innerHTML += `<div class="student-card"><span>Sĩ tử #${i+1}</span><h3>${name}</h3><p>Đạt NV1 mơ ước</p></div>`;
        });
        const examDate = new Date('June 26, 2027 07:30:00').getTime();
        setInterval(() => {
            const diff = examDate - new Date().getTime();
            if (diff > 0) {
                document.getElementById('days').innerText = Math.floor(diff / (1000 * 60 * 60 * 24));
                document.getElementById('hours').innerText = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                document.getElementById('minutes').innerText = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                document.getElementById('seconds').innerText = Math.floor((diff % (1000 * 60)) / 1000);
            }
        }, 1000);
        let notes = JSON.parse(localStorage.getItem('notes_12a4_v3')) || [];
        function renderNotes() {
            const notesGrid = document.getElementById('notesGrid');
            notesGrid.innerHTML = notes.map((n, idx) => `
                <div class="note-card">
                    <div><p>"${n.content}"</p>${n.image ? `<img src="${n.image}">` : ''}</div>
                    <div class="note-footer"><strong>- ${n.sender} -</strong>
                    <div><button class="btn-edit" onclick="editNote(${idx})">Sửa</button><button class="btn-delete" onclick="deleteNote(${idx})">Xóa</button></div></div>
                </div>`).join('');
        }
        function saveNote() {
            const sender = document.getElementById('senderName').value;
            const content = document.getElementById('noteContent').value;
            const file = document.getElementById('imageInput').files[0];
            if (!sender || !content) return alert('Điền đủ tên và nội dung!');
            const save = (img) => {
                notes.unshift({ sender, content, image: img });
                localStorage.setItem('notes_12a4_v3', JSON.stringify(notes));
                renderNotes();
            };
            if (file) { const r = new FileReader(); r.onload = e => save(e.target.result); r.readAsDataURL(file); }
            else save(null);
        }
        function deleteNote(i) { notes.splice(i, 1); localStorage.setItem('notes_12a4_v3', JSON.stringify(notes)); renderNotes(); }
        renderNotes();
    </script>
</body>
</html>
